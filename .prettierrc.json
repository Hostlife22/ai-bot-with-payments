{
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 100,
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<BUILTIN_MODULES>",
        "",
        "<THIRD_PARTY_MODULES>",
        "",
        "^@bootstrap/",
        "^@config/",
        "^@constants/",
        "^@messages/",
        "^@contracts/",
        "^@domain/",
        "^@app/",
        "^@(database|providers|payments|queues)/",
        "^@(telegram|admin|handlers|shop)/",
        "",
        "^\\.\\./",
        "^\\./"
    ],
    "importOrderTypeScriptVersion": "5.9.3",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
